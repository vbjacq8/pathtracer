CompileFlags:
  Compiler: /usr/bin/clang++
  Add:
    - -std=c++20
    - -c
    - -Iraytracer/src

---
# Edit CUDA sources as C++ + local stubs. Do not enable clang CUDA mode on Mac
# (it requires a toolkit and produces multiple jobs → clangd errors on line 1).
If:
  PathMatch: .*/raytracer/cuda/.*
CompileFlags:
  Remove:
    - -std=c++20
    - -Iraytracer/src
  Add:
    - -x
    - c++
    - -std=c++17
    - -c
    - -D__CUDACC__
    - -Iraytracer/cuda
    - -Iraytracer/cuda/device
    - -Iraytracer/cuda/host
    - -Iraytracer/cuda/intellisense
